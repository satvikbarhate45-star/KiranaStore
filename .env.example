# ==============================================================================
# Smart Kirana Enterprise - Environment Configuration
# ==============================================================================

# Database Configuration:
# Leave empty to use default high-performance SQLite (kirana.db) with WAL mode,
# or provide PostgreSQL URL: postgresql+psycopg://username:password@localhost:5432/kirana_db
DATABASE_URL=

# Application Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Ingestion SLAs and Thresholds
INGESTION_TIMEOUT_MS=2000
CLIENT_TIMEOUT_MS=2500
CIRCUIT_BREAKER_MAX_FAILURES=5
CIRCUIT_BREAKER_RESET_SECONDS=60

# Default Buyer ID for Local Single-Store / Family Ledger
DEFAULT_BUYER_ID=1

# Gemini AI Ingestion Credentials
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
